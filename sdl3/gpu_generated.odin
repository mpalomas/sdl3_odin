	PopGPUDebugGroup :: proc(command_buffer: ^GPUCommandBuffer) ---
	ReleaseGPUTexture :: proc(device: ^GPUDevice, texture: ^GPUTexture) ---
	ReleaseGPUSampler :: proc(device: ^GPUDevice, sampler: ^GPUSampler) ---
