@(default_calling_convention="c", link_prefix="SDL_")
foreign lib {
	GPUSupportsShaderFormats :: proc(format_flags: GPUShaderFormat, name: cstring) -> bool ---
	GPUSupportsProperties :: proc(props: PropertiesID) -> bool ---
