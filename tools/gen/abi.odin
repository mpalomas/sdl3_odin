package main

import "core:fmt"
import "core:strings"

//-----------//
// ABI CHECK //
//-----------//

// emit_abi_check writes two programs that print the same lines, one compiled from the C headers and one from the Odin
// bindings: every record's size, alignment and field offsets, every enum constant and every numeric or string macro.
// tools/abi/check.sh diffs their output.
emit_abi_check :: proc(e: ^Emitter) -> (c_program, odin_program: string) {
	c := strings.builder_make()
	o := strings.builder_make()
	fmt.sbprintf(&c, "// Generated by tools/gen from SDL %s. DO NOT EDIT.\n", e.api.sdl_version)
	strings.write_string(&c, "#define SDL_MAIN_HANDLED 1\n#include <SDL3/SDL.h>\n#include <SDL3/SDL_main.h>\n")
	strings.write_string(&c, "#include <SDL3/SDL_vulkan.h>\n#include <stdio.h>\n#include <stddef.h>\n\n")
	strings.write_string(&c, "#define ALIGN(T) offsetof(struct { char c; T t; }, t)\n\nint main(void) {\n")
	fmt.sbprintf(&o, "// Generated by tools/gen from SDL %s. DO NOT EDIT.\npackage main\n\n", e.api.sdl_version)
	strings.write_string(&o, "import \"core:fmt\"\nimport sdl \"../../../sdl3\"\n\nmain :: proc() {\n")

	for &header in e.api.headers {
		for &decl in header.decls {
			if skipped(e, decl.name) || platform_condition(&decl) != "" {
				continue
			}
			#partial switch decl.kind {
			case .Struct, .Union:
				abi_record(e, &c, &o, &decl)
			case .Enum:
				abi_enum(e, &c, &o, &decl)
			case .Macro:
				abi_macro(e, &c, &o, &decl)
			}
		}
	}
	strings.write_string(&c, "\treturn 0;\n}\n")
	strings.write_string(&o, "}\n")
	return strings.to_string(c), strings.to_string(o)
}

@(private="file")
abi_record :: proc(e: ^Emitter, c, o: ^strings.Builder, decl: ^Decl) {
	odin := odin_name(e, decl.name)
	fmt.sbprintf(c, "\tprintf(\"size %s %%zu\\n\", sizeof(%s));\n", decl.name, decl.name)
	fmt.sbprintf(c, "\tprintf(\"align %s %%zu\\n\", ALIGN(%s));\n", decl.name, decl.name)
	fmt.sbprintf(o, "\tfmt.printfln(\"size %s %%d\", size_of(sdl.%s))\n", decl.name, odin)
	fmt.sbprintf(o, "\tfmt.printfln(\"align %s %%d\", align_of(sdl.%s))\n", decl.name, odin)
	if _, replaced := e.overrides.types[decl.name]; replaced {
		return // an array or an integer in Odin: only the size and alignment are the same
	}
	fields := decl.fields
	if strings.has_suffix(decl.name, "Event") && decl.name != "SDL_CommonEvent" && starts_like_common_event(fields) {
		fmt.sbprintf(c, "\tprintf(\"offset %s.type %%zu\\n\", offsetof(%s, type));\n", decl.name, decl.name)
		fmt.sbprintf(o, "\tfmt.printfln(\"offset %s.type %%d\", offset_of(sdl.%s, commonEvent))\n", decl.name, odin)
		fields = fields[3:]
	}
	for field in fields {
		if field.name == "" || is_padding(decl.name, field.name) {
			continue
		}
		fmt.sbprintf(c, "\tprintf(\"offset %s.%s %%zu\\n\", offsetof(%s, %s));\n", decl.name, field.name, decl.name, field.name)
		fmt.sbprintf(o, "\tfmt.printfln(\"offset %s.%s %%d\", offset_of(sdl.%s, %s))\n", decl.name, field.name, odin,
			identifier(field.name))
	}
}

@(private="file")
abi_enum :: proc(e: ^Emitter, c, o: ^strings.Builder, decl: ^Decl) {
	odin := odin_name(e, decl.name)
	names := make([]string, len(decl.constants))
	for constant, i in decl.constants {
		names[i] = constant.name
	}
	prefix := enum_prefix(decl.name, names)
	fmt.sbprintf(c, "\tprintf(\"size %s %%zu\\n\", sizeof(%s));\n", decl.name, decl.name)
	fmt.sbprintf(o, "\tfmt.printfln(\"size %s %%d\", size_of(sdl.%s))\n", decl.name, odin)
	for constant in decl.constants {
		if e.overrides.skips[constant.name] {
			continue
		}
		member, member_ok := e.overrides.members[constant.name]
		if !member_ok {
			member = identifier(constant.name[len(prefix):])
		}
		fmt.sbprintf(c, "\tprintf(\"enum %s %%lld\\n\", (long long)%s);\n", constant.name, constant.name)
		fmt.sbprintf(o, "\tfmt.printfln(\"enum %s %%d\", i64(sdl.%s.%s))\n", constant.name, odin, member)
	}
}

@(private="file")
abi_macro :: proc(e: ^Emitter, c, o: ^strings.Builder, decl: ^Decl) {
	odin := odin_name(e, decl.name)
	if decl.ctype == "s" {
		fmt.sbprintf(c, "\tprintf(\"string %s %%s\\n\", %s);\n", decl.name, decl.name)
		fmt.sbprintf(o, "\tfmt.printfln(\"string %s %%s\", sdl.%s)\n", decl.name, odin)
		return
	}
	if decl.ctype == "f32" || decl.ctype == "f64" {
		fmt.sbprintf(c, "\tprintf(\"float %s %%.6g\\n\", (double)%s);\n", decl.name, decl.name)
		fmt.sbprintf(o, "\tfmt.printfln(\"float %s %%.6g\", f64(sdl.%s))\n", decl.name, odin)
		return
	}
	if strings.has_prefix(decl.ctype, "i") && !e.flags_macros[decl.name] {
		fmt.sbprintf(c, "\tprintf(\"value %s %%lld\\n\", (long long)%s);\n", decl.name, decl.name)
		fmt.sbprintf(o, "\tfmt.printfln(\"value %s %%d\", i64(sdl.%s))\n", decl.name, odin)
		return
	}
	fmt.sbprintf(c, "\tprintf(\"value %s %%llu\\n\", (unsigned long long)%s);\n", decl.name, decl.name)
	if e.flags_macros[decl.name] {
		// A bit_set constant: its bits, as the integer it's stored in.
		flags_type := flags_type_of(e, decl.name)
		fmt.sbprintf(o, "\tfmt.printfln(\"value %s %%d\", u64(transmute(sdl.%s)sdl.%s))\n", decl.name, flags_type, odin)
	} else {
		fmt.sbprintf(o, "\tfmt.printfln(\"value %s %%d\", u64(sdl.%s))\n", decl.name, odin)
	}
}

// flags_type_of is the integer type behind the bit_set a flag macro belongs to.
@(private="file")
flags_type_of :: proc(e: ^Emitter, macro: string) -> string {
	best, best_type := "", ""
	for c_name, flags in e.overrides.flags {
		prefix, _, _ := strings.partition(flags.prefix, "*")
		if strings.has_prefix(macro, prefix) && len(prefix) > len(best) {
			best = prefix
			best_type = type_text(e, e.typedefs[c_name].type, .Typedef, 0, c_name)
		}
	}
	return best_type
}
